    { "id": "sb-g5-001", "gradeLevel": 5, "prompt": "I _____ want to go.", "answer": "definitely", "choices": ["rhythm", "vacuum", "definitely", "privilege"], "context": "I definitely want to go." },
    { "id": "sb-g5-002", "gradeLevel": 5, "prompt": "Don't _____ your brother in public.", "answer": "embarrass", "choices": ["embarrass", "privilege", "rhythm", "tomorrow"], "context": "Don't embarrass your brother in public." },
    { "id": "sb-g5-003", "gradeLevel": 5, "prompt": "The drummer kept a steady _____.", "answer": "rhythm", "choices": ["definitely", "acquire", "embarrass", "rhythm"], "context": "The drummer kept a steady rhythm." },
    { "id": "sb-g5-004", "gradeLevel": 5, "prompt": "He hopes to _____ a new skill.", "answer": "acquire", "choices": ["acquire", "rhythm", "privilege", "definitely"], "context": "He hopes to acquire a new skill." },
    { "id": "sb-g5-005", "gradeLevel": 5, "prompt": "Driving is a _____, not a right.", "answer": "privilege", "choices": ["privilege", "definitely", "recommend", "acquire"], "context": "Driving is a privilege, not a right." },
    { "id": "sb-g5-006", "gradeLevel": 5, "prompt": "I _____ the chocolate cake.", "answer": "recommend", "choices": ["recommend", "privilege", "rhythm", "definitely"], "context": "I recommend the chocolate cake." },
    { "id": "sb-g5-007", "gradeLevel": 5, "prompt": "Please _____ the living room.", "answer": "vacuum", "choices": ["definitely", "privilege", "vacuum", "rhythm"], "context": "Please vacuum the living room." },

    { "id": "sb-g2-003", "gradeLevel": 2, "prompt": "She was the _____ to finish.", "answer": "first", "choices": ["does", "first", "always", "which"], "context": "She was the first to finish." },
    { "id": "sb-g2-004", "gradeLevel": 2, "prompt": "We walked _____ the park.", "answer": "around", "choices": ["friend", "many", "around", "would"], "context": "We walked around the park." },
    { "id": "sb-g2-005", "gradeLevel": 2, "prompt": "He _____ eats breakfast.", "answer": "always", "choices": ["which", "always", "friend", "their"], "context": "He always eats breakfast." },

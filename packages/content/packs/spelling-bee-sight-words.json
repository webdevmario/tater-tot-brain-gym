    { "id": "sb-g4-005", "gradeLevel": 4, "prompt": "The _____ passed a new law.", "answer": "government", "choices": ["probably", "government", "necessary", "actually"], "context": "The government passed a new law." },
    { "id": "sb-g4-006", "gradeLevel": 4, "prompt": "We ate at a new _____.", "answer": "restaurant", "choices": ["separate", "probably", "necessary", "restaurant"], "context": "We ate at a new restaurant." },
    { "id": "sb-g4-007", "gradeLevel": 4, "prompt": "Water is _____ for life.", "answer": "necessary", "choices": ["necessary", "calendar", "library", "restaurant"], "context": "Water is necessary for life." },
